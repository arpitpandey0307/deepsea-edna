# Copy to .env and fill in the values marked REQUIRED.
# docker compose reads this file; for local development (uvicorn from backend/)
# copy it to backend/.env instead. Never commit .env.

# ---- Security (REQUIRED) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Accounts with these emails are always admins (comma-separated). Everyone else signs up as viewer.
ADMIN_EMAILS=you@example.com

# ---- Database (REQUIRED for docker compose) ----
POSTGRES_DB=deepsea
POSTGRES_USER=deepsea
# Use letters and digits only (it is embedded in a connection URL)
POSTGRES_PASSWORD=

# ---- Public URLs ----
# Where users open the app, and where the browser reaches the API.
# Change both when deploying to a real domain (e.g. https://edna.example.org).
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- Google sign-in (optional; leave blank to hide the button) ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <BACKEND_PUBLIC_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub sign-in (optional; leave blank to hide the button) ----
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
# Authorization callback URL: <BACKEND_PUBLIC_URL>/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- MLflow model registry ----
# docker compose sets MLFLOW_TRACKING_URI=http://mlflow:5000 for the backend automatically.
# Standalone `docker run` with MLflow on the host: http://host.docker.internal:5000
# (inside a container, localhost is the container itself). Local uvicorn: http://localhost:5000
# MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=marine-edna-classifier
MLFLOW_MODEL_ALIAS=champion
MLFLOW_EXPERIMENT=marine-edna-classification
# mlflow = registry only (fail fast) | local = bundled files | auto = MLflow if configured, else bundled
MODEL_SOURCE=auto

# ---- Tuning (optional) ----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_SIZE=524288000
LOG_LEVEL=INFO

# ---- Local development only ----
# Without DATABASE_URL the backend uses a SQLite file at data/deepsea.db.
# DATABASE_URL=postgresql+psycopg://deepsea:password@localhost:5432/deepsea
# The Vite dev server reads this:
VITE_API_BASE_URL=http://localhost:8000
